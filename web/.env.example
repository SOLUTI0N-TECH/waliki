# Copia este archivo a web/.env y completa los valores. NUNCA subir .env al repo.

# Project ID de Reown (dashboard.reown.com → proyecto "Waliki")
VITE_REOWN_PROJECT_ID=

# RPC propio de Base Sepolia, HTTPS (opcional; si falta se usa https://sepolia.base.org)
VITE_RPC_URL=

# Comercio que cobra en la caja (id on-chain; el demo usa el #1)
VITE_MERCHANT_ID=1

# PIN del modo empleado de la caja (demo)
VITE_CAJA_PIN=1234

# ── Red y token ────────────────────────────────────────────────────────────
# Sin estas variables corre en Base Sepolia con el tUSDT de prueba.
# Para dinero real ver docs/MAINNET.md (ej. Base + USDT):
#   VITE_CHAIN_ID=8453
#   VITE_ROUTER=0x...        (router desplegado en esa red)
#   VITE_TOKEN=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2
#   VITE_TOKEN_SYMBOL=USDT
#   VITE_TOKEN_DECIMALS=6
#   VITE_IS_TESTNET=false    (apaga el faucet y el chip "Fase de prueba")
