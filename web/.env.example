# Copia este archivo a web/.env y completa los valores. NUNCA subir .env al repo.

# Project ID de Reown (dashboard.reown.com → proyecto "Waliki")
VITE_REOWN_PROJECT_ID=

# RPC propio de Base Sepolia, HTTPS (opcional; si falta se usa https://sepolia.base.org)
VITE_RPC_URL=

# Comercio que cobra en la caja (id on-chain; el demo usa el #1)
VITE_MERCHANT_ID=1

# PIN del modo empleado de la caja (demo)
VITE_CAJA_PIN=1234
