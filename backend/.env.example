# Copia este archivo a backend/.env y completa los valores. NUNCA subir .env al repo.

PORT=3000

# ── Yesca API (pasarela de QR bancario) ────────────────────────────────────
# Base del API; si se omite se usa https://dmb.miventa.dev/api
YESCA_API_BASE_URL=https://dmb.miventa.dev/api
# Token estático (no expira). Viaja como: Authorization: Bearer <token>
YESCA_API_TOKEN=

# ── Blockchain / Base Sepolia (chainId 84532) ──────────────────────────────
# URL completa del RPC. Aquí va bien el endpoint de Alchemy de Base Sepolia:
# este backend nunca escanea logs (ver README). Público: https://sepolia.base.org
RPC_URL=
# Clave privada de la wallet que PAGA los tUSDT. Solo wallet de testnet.
# Necesita tUSDT y ETH de Base Sepolia para el gas — cómo financiarla, en el README.
WALLET_PRIVATE_KEY=
# tUSDT del proyecto, ya desplegado (contracts/deployments/baseSepolia.json).
# El token NO se redespliega con el router: conserva todos los saldos.
TUSDT_CONTRACT_ADDRESS=0xc0934b34b2b1654ac5dc41b8a867e1227e03093d
# Fallback de decimales si decimals() del contrato falla
TUSDT_DECIMALS=6
# WalikiRouter (contracts/deployments/baseSepolia.json). OBLIGATORIA y sin valor
# por defecto: antes caía al router ya desplegado, y tras un redespliegue eso
# significa liquidar contra un contrato muerto sin que nadie se entere.
# Actualizar en cada redespliegue del router.
WALIKI_ROUTER_ADDRESS=
