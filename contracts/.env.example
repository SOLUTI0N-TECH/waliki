# Copia este archivo a contracts/.env y completa los valores. NUNCA subir .env al repo.

# Clave privada del deployer (MetaMask del dueño → Detalles de la cuenta → Exportar clave privada).
# Usar SOLO la wallet dev de testnet, jamás una con fondos reales.
PRIVATE_KEY=

# RPC de Base Sepolia (opcional; si se omite se usa https://sepolia.base.org)
RPC_URL=

# API key de Basescan (opcional; solo para `hardhat verify`)
BASESCAN_API_KEY=
